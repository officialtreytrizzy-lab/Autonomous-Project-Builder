{
  "name": "autonomous-project-builder",
  "version": "0.1.0",
  "description": "Private local autonomous software builder for Computer 2.",
  "author": "Autonomous Project Builder",
  "private": true,
  "main": "desktop/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-builder.ps1",
    "desktop:dev": "electron .",
    "desktop:test": "node --test tests/desktop-runtime.test.mjs tests/desktop-contract.test.mjs",
    "desktop:icon": "node scripts/generate-desktop-icon.mjs",
    "desktop:prepare": "npm run intake:worker:build && node scripts/prepare-desktop.mjs",
    "desktop:package": "npm run build && npm run desktop:prepare && npm run desktop:icon && electron-builder --dir --config desktop-builder.yml && node scripts/verify-desktop-package.mjs",
    "desktop:installer": "npm run build && npm run desktop:prepare && npm run desktop:icon && electron-builder --win nsis --config desktop-builder.yml && node scripts/verify-desktop-package.mjs",
    "desktop:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-desktop.ps1",
    "service:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-builder-service.ps1",
    "intake:worker:build": "node scripts/build-intake-worker.mjs",
    "fixtures:intake": "node tests/fixtures/create-intake-fixtures.mjs",
    "test:e2e": "playwright test tests/e2e/premium-builder.spec.mjs --project=chromium",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "file-type": "22.0.1",
    "lucide-react": "latest",
    "mammoth": "1.12.1",
    "next": "latest",
    "pdfjs-dist": "6.2.108",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "docx": "9.7.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "pdf-lib": "1.17.1",
    "sharp": "0.35.3",
    "typescript": "latest"
  }
}
